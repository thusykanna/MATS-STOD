# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# Anything already exported in your shell overrides what is set here.
# Check what the tool sees with:  uv run mats-stod check-llm

# ---------------------------------------------------------------------------
# Option A: Gemini on Vertex AI  (config: llm.backend = vertex, the default)
# ---------------------------------------------------------------------------
# Requires the gcloud CLI and one interactive login:
#   brew install --cask google-cloud-sdk
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com --project <your-project>
#
# Find your project id at https://console.cloud.google.com (top project menu).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Option B: Gemini on AI Studio  (set llm.backend = ai_studio in the config)
# ---------------------------------------------------------------------------
# No gcloud, no project, no billing. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Option C: any OpenAI-compatible endpoint (set llm.provider = openai_compat)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
